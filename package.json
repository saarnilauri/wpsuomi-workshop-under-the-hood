{
  "name": "wpsuomi-workshop-under-the-hood",
  "version": "0.1.0",
  "private": true,
  "description": "Workshop repo for \"Under the Hood: How Agentic WordPress Works\".",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "setup": "npm run start && npm run provision && npm run verify",
    "start": "wp-env start",
    "stop": "wp-env stop",
