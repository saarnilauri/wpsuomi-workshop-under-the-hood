    "verify": "bash ./bin/verify-env.sh",
    "cli": "wp-env run cli wp",
    "logs": "wp-env logs all",
    "inspector": "npx @modelcontextprotocol/inspector@2.5.0"
  },
  "devDependencies": {
    "@wordpress/env": "^11.14.0"
  }
}
